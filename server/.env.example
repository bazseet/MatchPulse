NODE_ENV=development
PORT=4040
CLIENT_ORIGIN=http://localhost:5174

# Optional Microsoft Foundry / Azure OpenAI-compatible Chat Completions integration.
# Copy the FULL chat/completions endpoint from your deployed model's endpoint page.
# Example shape only: https://YOUR-RESOURCE.openai.azure.com/openai/v1/chat/completions
FOUNDRY_CHAT_COMPLETIONS_URL=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=YOUR_DEPLOYMENT_NAME
FOUNDRY_TIMEOUT_MS=15000
